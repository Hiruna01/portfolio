# Copy to .env.local for local development. On Vercel, set these in the project's environment variables.

# Claude API key for the agent on the home page.
# Without it the site still runs, in demo mode (database search and a template, no model).
ANTHROPIC_API_KEY=

# Admin login for /admin. There is one admin and no sign-up.
# Create the hash with: npm run admin:hash
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Neon Postgres connection string. Required on Vercel.
# Leave empty locally to use a file database in .data/ that needs no setup.
DATABASE_URL=

# Vercel Blob token, for image uploads from the admin. Vercel adds it when you connect a Blob store.
# Locally, uploads are saved to public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=
